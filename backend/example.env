# PostgreSQL application credentials
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=job

# PostgreSQL admin credentials (used for migrations / RLS setup)
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change_me

POSTGRES_POOL_SIZE=5
POSTGRES_POOL_PRE_PING=true

# Redis (used for JWT token blacklist)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT settings
JWT_SECRET=change_this_to_a_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:5173

# --- Email (reminder delivery) ----------------------------------------------
# Mailtrap sandbox captures mail in a Mailtrap inbox rather than delivering it to
# the real address. Username and password: Mailtrap -> Inboxes -> SMTP Settings.
MAIL_SERVER=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=reminders@jobtracker.local
MAIL_FROM_NAME=JobTracker
MAIL_START_TLS=true
MAIL_SSL_TLS=false
MAIL_TIMEOUT=20
