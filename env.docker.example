# Template for the Docker Compose stack's configuration.
#
#   cp env.docker.example env.docker
#   docker compose --env-file env.docker up --build
#
# This file is tracked; env.docker is not. Copy it, then fill in the values
# marked CHANGE_ME below. Everything else works as-is for local development.
#
# Compose reads env.docker twice: once as the substitution source for ${...} in
# docker-compose.yml, and once as `env_file:` for the backend containers. That is
# why hostnames here are service names (postgres, redis) rather than localhost —
# these values are correct *inside* the network. For running on the host without
# Docker, use backend/.env and frontend/.env instead.

# --- Database ---------------------------------------------------------------
POSTGRES_DB=job

# The role the API connects as. Deliberately unprivileged: row-level security
# does not apply to superusers or, without FORCE, to the table owner.
POSTGRES_USER=app_user
POSTGRES_PASSWORD=CHANGE_ME

# The role that owns the schema and runs Alembic migrations.
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=CHANGE_ME

# Service name on the compose network, not localhost.
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_POOL_SIZE=5
POSTGRES_POOL_PRE_PING=true

# --- Redis (JWT revocation list) --------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# --- RabbitMQ (reminder delivery) -------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=jobtracker
RABBITMQ_PASSWORD=CHANGE_ME
RABBITMQ_VHOST=/

# Host port for the management UI (http://localhost:15672). Dev convenience only.
RABBITMQ_MANAGEMENT_PORT=15672

# --- Reminder workers -------------------------------------------------------
# Seconds between scans. Also the worst-case lateness of a reminder: one that
# comes due just after a scan waits for the next.
REMINDER_POLL_INTERVAL=10

# Reminders claimed per scan.
REMINDER_BATCH_SIZE=100

# How long a claim is trusted before another worker assumes the claimer died and
# takes the reminder back. Must exceed the time to publish one full batch.
REMINDER_LEASE_SECONDS=120

# Attempts before a reminder is abandoned as failed.
REMINDER_MAX_ATTEMPTS=5

# Messages one notifier holds at a time. Without this, the first consumer to
# connect is handed the whole queue and other replicas idle.
REMINDER_PREFETCH=10

# --- Email (how a due reminder reaches the user) -----------------------------
# Only the notifier uses these. Defaults below are Mailtrap's *sandbox*, which
# captures everything in a Mailtrap inbox instead of delivering to the real
# address — right for development, wrong for production. Grab the username and
# password from Mailtrap → Inboxes → SMTP Settings.
MAIL_SERVER=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME

# The From: header. With the sandbox this can be anything; a real provider will
# only accept a domain you have verified.
MAIL_FROM=reminders@jobtracker.local
MAIL_FROM_NAME=JobTracker

# STARTTLS for the submission ports (587, 2525); implicit TLS only for 465. Set
# one or the other, never both — they are different handshakes.
MAIL_START_TLS=true
MAIL_SSL_TLS=false

# Seconds one send may take. Keep it well under REMINDER_LEASE_SECONDS so a slow
# provider cannot outlast the claim and get the reminder reaped mid-send.
MAIL_TIMEOUT=20

# --- Auth -------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# The single origin allowed through CORS. Must match FRONTEND_PORT below.
FRONTEND_ORIGIN=http://localhost:5173

# --- Host ports -------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- Frontend build ---------------------------------------------------------
# Build-time only: Vite inlines this into the bundle, so it is passed as a build
# arg rather than a container variable. Must be reachable from the *browser*, so
# localhost and BACKEND_PORT — not http://backend:8000. Changing it requires
# `docker compose build frontend`.
VITE_API_URL=http://localhost:8000
